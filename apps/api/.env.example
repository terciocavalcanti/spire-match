# Copie para .env (nunca commitado) ao rodar localmente.
NODE_ENV=development
PORT=4000

# Postgres do docker-compose de desenvolvimento (infrastructure/docker/docker-compose.dev.yml)
# Porta 5433 no host — ajuste se sua máquina não tiver conflito na 5432.
DATABASE_URL=postgres://spire:spire@localhost:5433/spire_match

SESSION_COOKIE_NAME=spire_session
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Pendências externas reais (ver docs/deployment/DEPLOY_HOSTINGER.md) ---
# Deixe em branco em dev: cada integração fica desativada e sinalizada como
# pendente até a credencial real ser configurada. Nunca simular como ativa.
MAPTILER_API_KEY=
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=spire-match-dev
SMTP_URL=smtp://localhost:1025
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
LLM_PROVIDER_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
