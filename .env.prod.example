# Copie para `.env` na raiz do repositório NA VPS (nunca commitado) e edite
# os valores marcados como obrigatórios. Usado por:
# infrastructure/docker/docker-compose.prod.yml (API, web, admin, Caddy).
# Veja o passo a passo completo em docs/deployment/DEPLOY_HOSTINGER.md.

# --- Imagens Docker publicadas pelo GitHub Actions (GHCR) ---
# Troque "terciocavalcanti" se o dono do repositório no GitHub for outro.
API_IMAGE=ghcr.io/terciocavalcanti/spire-match-api:latest
WEB_IMAGE=ghcr.io/terciocavalcanti/spire-match-web:latest
ADMIN_IMAGE=ghcr.io/terciocavalcanti/spire-match-admin:latest

# --- Domínios (obrigatório: precisam ter um registro DNS tipo A apontando
# para o IP desta VPS antes de o Caddy conseguir emitir HTTPS automaticamente) ---
APP_DOMAIN=app.seudominio.com.br
ADMIN_DOMAIN=admin.seudominio.com.br
API_DOMAIN=api.seudominio.com.br

# --- Banco de dados (obrigatório) ---
# Escolha uma senha forte própria — nunca reutilize a de desenvolvimento.
POSTGRES_USER=spire
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=spire_match
# "postgres" é o nome do serviço Compose (rede interna), não um host real.
DATABASE_URL=postgres://spire:TROQUE_ESTA_SENHA@postgres:5432/spire_match

# --- Sessão / segurança (obrigatório) ---
NODE_ENV=production
PORT=4000
SESSION_COOKIE_NAME=spire_session
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://app.seudominio.com.br,https://admin.seudominio.com.br

# --- Pendências externas reais ---
# Deixe em branco até ter a credencial real: a feature correspondente fica
# sinalizada como pendente no app em vez de ser simulada como ativa.
MAPTILER_API_KEY=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
SMTP_URL=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
LLM_PROVIDER_API_KEY=

# --- Web Push (obrigatório para notificações push funcionarem) ---
# NÃO é uma credencial de terceiro — gere seu próprio par em qualquer
# máquina com Node: `npm i -g web-push && node -e "console.log(require('web-push').generateVAPIDKeys())"`.
# Nunca reaproveite o par de desenvolvimento do repositório em produção.
# A chave pública é servida ao PWA via API (GET /notifications/vapid-public-key)
# em tempo real — não precisa ser embutida no build do frontend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
