# Variáveis consumidas pelo docker-compose de desenvolvimento
# (infrastructure/docker/docker-compose.dev.yml). Copie para `.env` na raiz
# do repositório para customizar — os defaults já funcionam sem edição.
# Cada app tem seu próprio .env.example (apps/api, apps/web, apps/admin).

POSTGRES_USER=spire
POSTGRES_PASSWORD=spire
POSTGRES_DB=spire_match
# 5433 no host evita colisão com um PostgreSQL nativo já instalado (comum em
# stacks como Laragon/XAMPP, que normalmente ocupam a 5432 por padrão).
POSTGRES_PORT=5433

REDIS_PORT=6379

MINIO_ROOT_USER=spire
MINIO_ROOT_PASSWORD=spirematch123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MAILHOG_SMTP_PORT=1025
# 8025 colide com uma porta reservada em algumas máquinas Windows; 8026 como default seguro.
MAILHOG_UI_PORT=8026
